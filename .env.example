# ── Real project (aurapixel-ops): this is what .env.local holds ──
# Get the web config from Firebase console → Project settings → Your apps, or ask Claude.
# NEXT_PUBLIC_FIREBASE_API_KEY=
# NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
# NEXT_PUBLIC_FIREBASE_PROJECT_ID=
# NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
# NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
# NEXT_PUBLIC_FIREBASE_APP_ID=
# Server: the org blocks service-account keys, so locally use
# `gcloud auth application-default login` plus:
# GOOGLE_CLOUD_QUOTA_PROJECT=aurapixel-ops
# On Vercel (no key files): keyless Workload Identity Federation, set up by
# `npm run setup:vercel-access`, which prints these two values.
# GCP_WORKLOAD_IDENTITY_PROVIDER=projects/<number>/locations/global/workloadIdentityPools/vercel/providers/vercel
# GCP_SERVICE_ACCOUNT_EMAIL=ops-server@aurapixel-ops.iam.gserviceaccount.com
# Only if a key is ever allowed (keep the literal \n in the private key):
# FIREBASE_CLIENT_EMAIL=
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# ── Connections (server only; shown as set / not set in Settings > Connections) ──
# The assistant that drafts replies (Claude).
# ANTHROPIC_API_KEY=
# n8n: where Ops sends "send this email" requests, and the shared secret both sides check.
# N8N_WEBHOOK_URL=http://localhost:5678/webhook
# OPS_WEBHOOK_SECRET=
