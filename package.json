{
  "name": "ap-ops",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3100",
    "build": "next build",
    "start": "next start -p 3100",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --no-warnings scripts/test-clean.ts && node --experimental-strip-types --no-warnings scripts/test-blasts.ts",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "deploy:rules": "node scripts/deploy-rules.mjs",
    "setup:signin": "node scripts/setup-signin.mjs",
    "grant-admin": "node scripts/grant-admin.mjs",
    "setup:vercel-access": "node scripts/setup-vercel-access.mjs",
    "setup:email": "node scripts/setup-email.mjs",
    "setup:secrets": "node scripts/setup-secrets.mjs"
  },
  "dependencies": {
    "@ark-ui/react": "^5.39.3",
    "@vercel/oidc": "^4.0.0",
    "clsx": "^2.1.1",
    "firebase": "^12.19.0",
    "firebase-admin": "^14.5.0",
    "google-auth-library": "^11.2.0",
    "lucide-react": "^1.52.0",
    "next": "16.4.0",
    "papaparse": "^5.7.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwind-merge": "^3.7.0",
    "tailwind-variants": "^3.3.1",
    "tw-animate-css": "^1.4.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "prettier": "^3.9.9",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "overrides": {
    "jwks-rsa": {
      "jose": "^5.10.0"
    }
  }
}
